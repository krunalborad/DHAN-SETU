# MongoDB Atlas (or local) connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/stock-portfolio-tracker

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=replace-this-with-a-long-random-secret

# How long access tokens stay valid
JWT_EXPIRES_IN=7d

# Port the Express server listens on
PORT=5000

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# --- Optional integrations (not required to run the app) ---
# Real market-data provider, to replace the frontend's simulated feed
STOCK_API_KEY=

# LLM provider key, to replace the local weekly-summary stub with real AI
AI_API_KEY=

# Email provider (e.g. SMTP via Nodemailer) for price-alert notifications
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
